# Node modules
node_modules/

# Build files
dist/
build/

# Environment files
.env
.env.*
.env.local
.env.development
.env.production

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor folders
.vscode/
.idea/

# Cache
.cache/
*.tmp

# Others
*.swp
